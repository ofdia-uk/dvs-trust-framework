{
  "name": "dvs-trust-framework-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reading website for the working draft of the UK digital verification services trust framework.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "eleventy && npm run build:css",
    "build:css": "sass --no-source-map --style=compressed --load-path=node_modules --quiet-deps src/site.scss _site/assets/site.css",
    "start": "npm run build:css && eleventy --serve",
    "test": "node --test \"test/**/*.test.js\"",
    "rules": "node scripts/rule-identities.js",
    "feedback": "node scripts/existing-feedback.js",
    "provenance": "node scripts/change-provenance.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "govuk-frontend": "^6.6.0",
    "markdown-it-abbr": "^2.0.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "sass": "^1.107.0"
  }
}
